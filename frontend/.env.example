# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real API keys.

# Optional: a shared, tightly-restricted key so visitors can try QuickMap
# before bringing their own. Restrict it (HTTP referrer to your deployed
# domain; API restrictions to Maps JavaScript API, Geocoding API, Routes
# API) AND cap its daily request quota per API in Cloud Console — once
# that's hit, Google rejects further calls and the app falls back to
# asking visitors for their own key. See the README's "Bring your own
# Google Maps API key" section. Leave unset locally to always use the
# visitor-key flow yourself during development.
VITE_GOOGLE_MAPS_DEMO_KEY=

# Map ID for AdvancedMarkerElement (Cloud Console → Google Maps Platform →
# Map Management → Create Map ID). Optional locally — falls back to
# Google's "DEMO_MAP_ID" placeholder — but required before deploying to
# production. Unlike an API key, a Map ID isn't a secret and doesn't
# drive billing on its own, so it's fine to bake into the build.
VITE_GOOGLE_MAPS_MAP_ID=

# URL of your deployed quickmap-worker (see ../worker). For local dev with
# `wrangler dev` this is usually http://localhost:8787
VITE_WORKER_URL=
