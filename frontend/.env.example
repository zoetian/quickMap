# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real API keys.

# Browser (client-side) key, restricted by HTTP referrer to your dev/prod
# domains. Needs Maps JavaScript API, Geocoding API, Directions API, and
# Routes API enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for AdvancedMarkerElement (Cloud Console → Google Maps Platform →
# Map Management → Create Map ID). Optional locally — falls back to
# Google's "DEMO_MAP_ID" placeholder — but required before deploying to
# production.
VITE_GOOGLE_MAPS_MAP_ID=

# URL of your deployed quickmap-worker (see ../worker). For local dev with
# `wrangler dev` this is usually http://localhost:8787
VITE_WORKER_URL=
